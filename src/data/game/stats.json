 "primaryStats": [
  {
   "key": "totalAttack",
   "unit": "integer",
   "formula": "floor((base.attack + sum(gear primaryStats.attack) + pet.flatAttack + sigil.flatAttack + stone.flatAttack) * (1 + attackPercentSum/100) * (formConfig.attackMult ?? 1))",
   "citation": "L1217155-1217165"
  },
  {
   "key": "totalHp",
   "unit": "integer",
   "formula": "floor((base.hp + sum(gear primaryStats.hp) + pet.flatHp + sigil.flatHp + stone.flatHp + sum(gear primaryStats.hp) * ((formConfig.gearHpMult ?? 1) - 1)) * (1 + hpPercentSum/100))",
   "citation": "L1217166-1217174"
  }
 ],
