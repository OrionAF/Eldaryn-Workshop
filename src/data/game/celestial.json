  "formulas": {
    "bossStats": "getCelestialBossStats(level, difficulty=NORMAL, atkLevel=level) L1156882: mult(L)=prod_{l=ref+1..L}(1+band(l).growth), band(l)=last band with fromLevel<=l; hp=round(baseHp*hpMult(level)*bossStatMultiplier); attack=round(baseAttack*atkMult(atkLevel)*bossStatMultiplier); attackSpeed=scaling.attackSpeed; spellResist=bossSpellResist. Optional 3rd arg atkLevel has no client caller (server-side, UNRESOLVED).",
    "addStats": "getCelestialAddStats(level, difficulty) L1158519: hp=round(boss.hp*addHpFraction), attack=round(boss.attack*addAttackFraction), attackSpeed=addAttackSpeed, spellResist=boss.spellResist",
    "playerPowerProxy": "celestialPlayerPowerProxy(stats, resonanceMult) L1157065 = totalAttack*totalAttackSpeed*(1+totalCritChance/100*(totalCritDamage-1))*(1+totalDoubleHit/100)*resonanceMult",
    "partyPowerProxy": "celestialPartyPowerProxy(members, aggregation='MAX') L1158572: MAX (or SUM) of playerPowerProxy",
    "partyPowerHpMultiplier": "celestialPartyPowerHpMultiplier(proxy, cfg) L1158649 = proxy finite & >0 ? max(1, multiplier*(proxy/referenceProxy)^exponent) : 1  (MYTHIC only: 2.5, 0.75, 139e6)",
    "committedScalingLevel": "celestialCommittedScalingLevel(OL, difficulty) L1158449 = round(intercept + perOblivionLevel*max(1,OL)); null for MYTHIC. Presumably maps an Oblivion-committed character to a NORMAL/HARD boss level (caller server-side).",
    "dustRange": "get*DustRange(level, difficulty) L1157278/L1157386/L1157498: avg=baseAvgAtRef+max(0,level-ref)*perLevel; min=max(1,floor(avg)), max=max(1,ceil(avg)); roll=min+floor(rand*(max-min+1)); total split 1 unit at a time to random participants (rollCelestialDrops L1158913).",
    "glyphChance": "getGlyphRarityChances(tierCfg, level) L1157088: per rarity, linear interpolation between anchor levels, clamped to first/last anchor. Each rarity rolled independently (rand < chance), winner = random participant.",
    "holderSwings": "celestialHolderSwings(p, level, diff, adds) L1157609 = p.totalHp*max(0.1,1-hpPerAdd*adds) / (boss.attack*(1-min(.95,max(0,DR*(1-drPerAdd*adds))/100))*(1-min(.95,min(95,block+miss)/100*max(0,1-blockPerAdd*adds)))*(1+damageTakenPerAdd*adds))",
    "autoHoldCount": "celestialAutoHoldCount L1159593: largest n in [bounds.max..bounds.min] with holderSwings >= 20",
    "maxHoldCount": "getCelestialMaxHoldCount L1159404 = max(1, min(maxAlive, overload.enabled ? addsThreshold : maxAlive))"
  },
